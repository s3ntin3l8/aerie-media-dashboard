{
  "$schema": "https://raw.githubusercontent.com/s3ntin3l8/visual-kit/main/schema/scenes.schema.json",
  "demo": {
    "start": "[ -d node_modules ] || npm ci --no-audit --no-fund && make demo",
    "url": "http://127.0.0.1:3930",
    "readyOutput": "DEMO_READY",
    "startTimeoutSec": 900,
    "env": {
      "DEMO_NOW": "2026-10-15T10:00:00Z",
      "DEMO_HEALTH_TIMEOUT_MS": "240000",
      "DEMO_STORAGE_STATE": ".demo/storage-state.json"
    }
  },
  "cacheKeyFiles": ["package-lock.json", ".github/visual-setup.sh"],
  "baseHarness": ["scripts/demo"],
  "clock": "2026-10-15T10:00:00Z",
  "scenes": [
    {
      "name": "home",
      "path": "/",
      "tags": ["presentation", "check", "audit"],
      "baseline": true,
      "settle": "text=Brightwater Station"
    },
    {
      "name": "streams",
      "path": "/streams",
      "tags": ["presentation", "check", "audit"],
      "baseline": true,
      "settle": "text=The Lantern Archive"
    },
    {
      "name": "requests",
      "path": "/requests",
      "tags": ["presentation", "check", "audit"],
      "viewports": ["desktop"],
      "settle": "text=Brightwater Station"
    },
    {
      "name": "status",
      "path": "/status",
      "tags": ["presentation", "check", "audit"],
      "viewports": ["desktop"],
      "settle": "text=NZBGet"
    },
    {
      "name": "home-live",
      "path": "/",
      "tags": ["presentation"],
      "stills": false,
      "settle": "text=Brightwater Station",
      "loop": { "tailSec": 0.5 },
      "steps": [{ "wait": 4000 }, { "wait": 4000 }]
    },
    {
      "name": "admin",
      "path": "/admin",
      "tags": ["audit"]
    },
    {
      "name": "services",
      "path": "/services",
      "tags": ["audit"]
    },
    {
      "name": "embed-sonarr",
      "path": "/s/sonarr",
      "tags": ["audit"]
    },
    {
      "name": "not-found",
      "path": "/does-not-exist",
      "tags": ["audit"]
    },
    {
      "name": "palette",
      "path": "/",
      "tags": ["audit"],
      "settle": "text=Brightwater Station",
      "steps": [{ "press": "Control+k" }, { "wait": 600 }]
    }
  ]
}
