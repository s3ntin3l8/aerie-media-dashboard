# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent state
/.claude/

# local docker-compose overrides (personal settings)
docker-compose.override.yml

# local sqlite data
/data

# local service config (keep the .example, ignore the real one)
/config/aerie.yaml

# design prototype (local reference only; not shipped)
/design/prototype/

# Superpowers
docs/superpowers/
.opencode/
coverage/

# vitest junit output (CI)
test-results/

# Developer worktrees (per AGENTS.md make wt convention)
.wt/

# Landing-page capture output (make screenshots-landing)
/landing-shots/

# visual-kit: the launcher extracted from the pinned image, check output, and staging leftovers of a killed run
/visual/.kit/
/visual/.out/

# The demo's signed-in session while `make demo` runs (visual/host-hooks.sh hands it to the capture)
/.demo/

# Visual-audit evidence (make screenshots-audit)
/docs/audit/assets/
